                <a href="#" class="profile-card__social" aria-label="{{ person.name }} social link 2"></a>
                <a href="#" class="profile-card__social" aria-label="{{ person.name }} social link 3"></a>
              </div>
            </article>
            {% endif %}
            {% endfor %}
