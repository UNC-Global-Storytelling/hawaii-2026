################################################################################
# CONSOLIDATED ENVIRONMENT VARIABLES
# This single .env file is used for BOTH Postgres and Directus deployments
# NEVER commit this file to git!
################################################################################

# ============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# These values define the database that will be created when Postgres deploys
# IMPORTANT: These MUST be synchronized with the Directus DB_* variables below!
#
POSTGRES_DB=DB_name
POSTGRES_USER=User_name
POSTGRES_PASSWORD=secure_password # Choose a strong password for the database user

# ============================================================================
# DIRECTUS CMS CONFIGURATION
# ============================================================================

# Core Settings
DIRECTUS_KEY=secure_key # Generate a random 32-character string for this
DIRECTUS_SECRET=secure_secret # Generate a random 64-character string for this
NODE_ENV=production

# ⚠️  DATABASE CONFIGURATION - MUST MATCH POSTGRES VALUES ABOVE!
#
# Mapping (MUST BE IDENTICAL):
#   DB_DATABASE  ←→  POSTGRES_DB     = directus
#   DB_USER      ←→  POSTGRES_USER   = directus
#   DB_PASSWORD  ←→  POSTGRES_PASSWORD
#
DB_CLIENT=postgres
DB_HOST=postgres.<yournamespace>.svc.cluster.local
DB_PORT=5432
DB_DATABASE=DB_name
DB_USER=User_name
DB_PASSWORD=secure_password

# Initial Admin User (created on first Directus startup)
ADMIN_EMAIL=brookenf@unc.edu
ADMIN_PASSWORD=secure_admin_password # Choose a strong password for the admin user

# Extension Settings
EXTENSIONS_PATH=./extensions

# Cache Configuration
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true

# Logging
LOG_LEVEL=info

# ============================================================================
# 11TY FRONTEND CONFIGURATION (Optional)
# ============================================================================
# For connecting your 11ty frontend to Directus API:
#
DIRECTUS_API_URL=https://directus.example.com
DIRECTUS_API_TOKEN=your-directus-api-token-here
