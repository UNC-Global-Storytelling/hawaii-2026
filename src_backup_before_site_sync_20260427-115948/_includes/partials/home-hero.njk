<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <img src="{{ home.heroLandscape }}" alt="Maui landscape">
  </div>
  <div class="hero__gradient" aria-hidden="true"></div>
  <div class="hero__titles">
    <div class="hero__deco" aria-hidden="true">
      <img src="{{ home.logos.heroDecoration }}" alt="">
    </div>
    <div class="hero__title-text">
      <h1>Mālama Maui</h1>
      <p>The Land We Hold</p>
    </div>
  </div>
  <button type="button" class="hero__scroll" data-scroll-target="#intro-heading">
    <span>scroll to learn more</span>
    <svg class="hero__chev" viewBox="0 0 42.2609 42.2609" fill="none" aria-hidden="true">
      <path d="M10.5652 15.8478L21.1304 26.413L31.6957 15.8478" stroke="black" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.52174"/>
    </svg>
  </button>
</section>
