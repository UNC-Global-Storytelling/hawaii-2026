  <div class="everyone__inner">
    <h2 id="everyone-title" data-people-heading>Everyone</h2>
    <div class="everyone__canvas">
      <div class="everyone__grid">
      {% for person in people %}
      <article class="profile-card" data-profile-card data-category="{{ person.category }}" data-group="{{ person.group }}" data-blob="{{ person.blob }}">
        <div class="profile-card__avatar" aria-hidden="true">
          <span></span>
          <span></span>
        </div>
        <p class="profile-card__meta">
          {{ person.role }}{% if person.group %} | {{ person.group }}{% endif %}
        </p>
        <h3>{{ person.name }}</h3>
        <div class="profile-card__socials" aria-label="Social links">
          <a href="#" class="profile-card__social" aria-label="{{ person.name }} social link 1"></a>
          <a href="#" class="profile-card__social" aria-label="{{ person.name }} social link 2"></a>
          <a href="#" class="profile-card__social" aria-label="{{ person.name }} social link 3"></a>
        </div>
        {% if person.portfolio %}
        <a href="#" class="profile-card__portfolio">PORTFOLIO</a>
        {% endif %}
      </article>
      {% endfor %}
      </div>
    </div>
    <div class="teams-scroll" data-teams-scroll hidden>
      {% set team_order = ["ECO", "OCEAN", "RESILIENCE", "FOOD", "CULTURE", "FACULTY/COACHES", "LOCAL PRODUCERS"] %}
      {% set team_labels = {
        "ECO": "Eco",
        "OCEAN": "Ocean",
        "RESILIENCE": "Resilience",
        "FOOD": "Food",
        "CULTURE": "Culture",
        "FACULTY/COACHES": "Faculty/Coaches",
        "LOCAL PRODUCERS": "Local Producers"
      } %}
      {% for team_name in team_order %}
      <section class="team-block" data-team="{{ team_name }}">
        <h3>{{ team_labels[team_name] }}</h3>
        <div class="team-block__blob" data-blob-bg="{% if team_name == 'ECO' %}green{% elif team_name == 'OCEAN' %}navy{% elif team_name == 'RESILIENCE' %}blue{% elif team_name == 'FOOD' %}brown{% elif team_name == 'CULTURE' %}red{% else %}purple{% endif %}">
          <div class="team-block__grid">
            {% for person in people %}
            {% if person.team == team_name %}
            <article class="profile-card profile-card--mini" data-blob="{{ person.blob }}">
              <div class="profile-card__avatar" aria-hidden="true">
                <span></span>
                <span></span>
              </div>
              <p class="profile-card__meta">
                {{ person.role }}{% if person.group %} | {{ person.group }}{% endif %}
